# ═══════════════════════════════════════════════════════════════
# ShinePRO CRM — npm configuration
# ═══════════════════════════════════════════════════════════════

# ЗАВЖДИ зберігати точні версії (без ^ та ~)
save-exact=true

# Не оновлювати package-lock.json автоматично
package-lock=true

# Використовувати точні версії з lock-файлу
prefer-offline=true

# Не запускати скрипти при install (безпека)
ignore-scripts=false

# Не показувати funding повідомлення
fund=false

# Не показувати audit повідомлення при install
audit=false
